# This is a template for your settings. Copy it to a file called .env and fill in your own values.
# Never commit .env to git, because it holds your passwords and keys.

# AWS and Bedrock: where the AI models come from.
# Sign in with an AWS profile, or with access keys. Only fill in the keys if you're not using a profile.
AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# The main model, which talks to the user, calls tools and speaks Pidgin. Any Bedrock Claude model your account
# can use will work. We use Claude Haiku because it's fast and cheap, and it passed every tool and safety test.
AGENT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# The cheap, quick model for chat summaries and text-to-Cypher queries.
FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# The model that extracts the graph from the documents and grades the evaluation. Accuracy matters more than speed here.
EXTRACTION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# The model that turns text into vectors, and how big each vector is. Titan V2 supports 256, 512 or 1024.
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024

# Neo4j AuraDB Free: the database that holds the knowledge graph and the document vectors.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Tuning for search and memory.
# Neo4j scores how similar a chunk is from 0 to 1. Anything below this counts as "not relevant".
MIN_RELEVANCE=0.70
# How many chunks each search hands back to the agent.
TOP_K=4
# Short-term memory, handled by our own rolling-summary manager. Once a chat passes SUMMARY_TRIGGER_TURNS user
# turns, the last KEEP_RECENT_MESSAGES messages are kept word for word and everything older is summarised.
SUMMARY_TRIGGER_TURNS=30
KEEP_RECENT_MESSAGES=12
# How often, in user turns, to refresh the short summary that's remembered between chats.
SUMMARY_EVERY_N_TURNS=4

# Where the Streamlit app finds the API server.
API_URL=http://localhost:8000
